pipeline {
    agent any
    environment {
        // variable = value 
        IMAGE_BACKEND = 'todo-backend'
        IMAGE_FRONTEND = 'todo-frontend'
        MAIL_TO = 'abhiranjank037@gmail.com'
    }

    stages {

        stage("Entry"){
            steps{
                echo "This is entry point"
            }
        }
        stage('Stop and Remove Containers') {
            steps {
                bat '''
                docker-compose down || exit /b 0
                '''
            }
        }

        stage('Remove Old Images') {
            steps {
                bat '''
                docker rmi %IMAGE_BACKEND% || exit /b 0
                docker rmi %IMAGE_FRONTEND% || exit /b 0
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                bat 'docker-compose build'
            }
        }

        stage('Start Containers') {
            steps {
                bat 'docker compose up -d'
            }
        }
    }
// this is modification i done
    post {
        success {
            mail to: "${MAIL_TO}",
                 subject: "🚀 CI/CD Success: Todo App",
                 body: "The build and deployment of your Dockerized app completed successfully!"
        }
        failure {
            mail to: "${MAIL_TO}",
                 subject: "❌ CI/CD Failed: Todo App",
                 body: "Something went wrong. Please check the Jenkins logs."
        }
    }
}
